{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/inlay.schema.prototype.json",
  "title": "Lucent Inlay Layer Manifest (Prototype)",
  "description": "PROTOTYPE: the Modrinth mrpack index plus only the fields required for Layer inheritance, exclusions, and repository delivery.",
  "type": "object",
  "required": [
    "$schema",
    "formatVersion",
    "game",
    "versionId",
    "name",
    "files",
    "dependencies"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "extends": {
      "$ref": "#/$defs/parent"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "default": []
    },
    "delivery": {
      "description": "Opt into commit-addressed GitHub delivery for repository-backed files. If absent, repository-backed files are bundled as mrpack overrides.",
      "const": "github"
    },
    "formatVersion": {
      "const": 1
    },
    "game": {
      "const": "minecraft"
    },
    "versionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/modrinthFile"
          },
          {
            "$ref": "#/$defs/repositoryFile"
          }
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contentPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)(?!.*/$)[^\\u0000]+$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{128}$"
    },
    "hashes": {
      "type": "object",
      "required": [
        "sha1",
        "sha512"
      ],
      "properties": {
        "sha1": {
          "$ref": "#/$defs/sha1"
        },
        "sha512": {
          "$ref": "#/$defs/sha512"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositoryHashes": {
      "type": "object",
      "required": [
        "sha1",
        "sha256"
      ],
      "properties": {
        "sha1": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "environmentPolicy": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "unsupported"
      ]
    },
    "modrinthFile": {
      "type": "object",
      "required": [
        "path",
        "hashes",
        "downloads",
        "fileSize"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/contentPath"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        },
        "env": {
          "type": "object",
          "required": [
            "client",
            "server"
          ],
          "properties": {
            "client": {
              "$ref": "#/$defs/environmentPolicy"
            },
            "server": {
              "$ref": "#/$defs/environmentPolicy"
            }
          },
          "additionalProperties": false
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "repositoryFile": {
      "title": "Repository-backed file or directory",
      "description": "An Inlay authoring entry for one Git-tracked regular file. A build verifies its repository-relative source against the declared SHA-1, SHA-256, and byte size. Bundled builds omit it from modrinth.index.json and place it in the appropriate override directory; GitHub-hosted builds replace it with a commit-addressed HTTPS entry and add the SHA-512 required by Modrinth.",
      "type": "object",
      "required": [
        "path",
        "hashes",
        "downloads",
        "fileSize"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/contentPath"
        },
        "hashes": {
          "$ref": "#/$defs/repositoryHashes"
        },
        "env": {
          "type": "object",
          "required": [
            "client",
            "server"
          ],
          "properties": {
            "client": {
              "$ref": "#/$defs/environmentPolicy"
            },
            "server": {
              "$ref": "#/$defs/environmentPolicy"
            }
          },
          "additionalProperties": false
        },
        "downloads": {
          "type": "array",
          "description": "Exactly one regular-file path relative to the repository root.",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^\\./(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
          }
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "parent": {
      "title": "Immutable parent",
      "description": "The single verified parent file. The URL and optional resolution hints must identify exactly one inlay.index.json or Pack artifact. Hashes and size always describe its exact bytes.",
      "type": "object",
      "required": [
        "url",
        "hashes",
        "fileSize"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "description": "Optional resolution hint: a full Git commit ID or Modrinth version ID. It may be omitted when the URL already identifies an immutable file.",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "description": "Optional filename override. Git repositories default to inlay.index.json; Modrinth versions default to their single .mrpack. Use this only for a nonstandard or ambiguous artifact name.",
          "minLength": 1,
          "pattern": "^(?!.*[\\\\/])[^\\u0000]+$"
        },
        "hashes": {
          "$ref": "#/$defs/repositoryHashes"
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/contentPath"
        },
        "recursive": {
          "type": "boolean",
          "default": false
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "client",
              "server"
            ]
          },
          "default": [
            "client",
            "server"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
