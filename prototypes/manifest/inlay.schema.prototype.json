{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/inlay.schema.prototype.json",
  "title": "Lucent Inlay Layer Manifest (Prototype)",
  "description": "PROTOTYPE: the Modrinth mrpack index plus only the fields required for Layer inheritance, exclusions, and repository delivery.",
  "type": "object",
  "required": [
    "$schema",
    "formatVersion",
    "game",
    "versionId",
    "name",
    "files",
    "dependencies"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "extends": {
      "oneOf": [
        {
          "$ref": "#/$defs/gitParent"
        },
        {
          "$ref": "#/$defs/modrinthParent"
        }
      ]
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "default": []
    },
    "delivery": {
      "description": "Opt into commit-addressed GitHub delivery for repository-backed files. If absent, repository-backed files are bundled as mrpack overrides.",
      "const": "github"
    },
    "formatVersion": {
      "const": 1
    },
    "game": {
      "const": "minecraft"
    },
    "versionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/modrinthFile"
          },
          {
            "$ref": "#/$defs/repositoryFile"
          }
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contentPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)(?!.*/$)[^\\u0000]+$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{128}$"
    },
    "hashes": {
      "type": "object",
      "required": [
        "sha1",
        "sha512"
      ],
      "properties": {
        "sha1": {
          "$ref": "#/$defs/sha1"
        },
        "sha512": {
          "$ref": "#/$defs/sha512"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "environmentPolicy": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "unsupported"
      ]
    },
    "modrinthFile": {
      "type": "object",
      "required": [
        "path",
        "hashes",
        "downloads",
        "fileSize"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/contentPath"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        },
        "env": {
          "type": "object",
          "required": [
            "client",
            "server"
          ],
          "properties": {
            "client": {
              "$ref": "#/$defs/environmentPolicy"
            },
            "server": {
              "$ref": "#/$defs/environmentPolicy"
            }
          },
          "additionalProperties": false
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "repositoryFile": {
      "title": "Repository-backed file or directory",
      "description": "An Inlay authoring entry. A single repository-relative download source is expanded during build. Bundled builds omit it from modrinth.index.json and place its files in the appropriate override directory; GitHub-hosted builds replace it with commit-addressed HTTPS entries and computed hashes and sizes.",
      "type": "object",
      "required": [
        "path",
        "downloads"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/contentPath"
        },
        "env": {
          "type": "object",
          "required": [
            "client",
            "server"
          ],
          "properties": {
            "client": {
              "$ref": "#/$defs/environmentPolicy"
            },
            "server": {
              "$ref": "#/$defs/environmentPolicy"
            }
          },
          "additionalProperties": false
        },
        "downloads": {
          "type": "array",
          "description": "Exactly one path relative to the repository root. The source may be a regular file or directory; directories expand recursively.",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^\\./(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "tag"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "release"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "gitParent": {
      "title": "Git Layer parent",
      "description": "A repository URL and immutable full commit. The optional selector is provenance only.",
      "type": "object",
      "required": [
        "url",
        "version"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "description": "Full SHA-1 or SHA-256 Git commit ID.",
          "pattern": "^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "additionalProperties": false
    },
    "modrinthParent": {
      "title": "Modrinth mrpack parent",
      "description": "The exact Modrinth project/version and selected artifact tuple.",
      "type": "object",
      "required": [
        "url",
        "project",
        "version",
        "filename",
        "hashes",
        "size"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.mrpack$"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/contentPath"
        },
        "recursive": {
          "type": "boolean",
          "default": false
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "client",
              "server"
            ]
          },
          "default": [
            "client",
            "server"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
