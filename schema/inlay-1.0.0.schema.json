{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lucent-mc/inlay/schema-v1.0.0/schema/inlay-1.0.0.schema.json",
  "title": "Lucent Inlay Layer Manifest",
  "description": "A strict extension of the Modrinth pack manifest with immutable single-parent layering.",
  "type": "object",
  "required": ["$schema", "formatVersion", "game", "versionId", "name", "files", "dependencies"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "extends": { "$ref": "#/$defs/parent" },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" },
      "default": []
    },
    "delivery": { "const": "github" },
    "docs": { "$ref": "#/$defs/repositoryDirectory" },
    "formatVersion": { "const": 1 },
    "game": { "const": "minecraft" },
    "versionId": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "summary": { "type": "string", "maxLength": 2048 },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [{ "$ref": "#/$defs/remoteFile" }, { "$ref": "#/$defs/repositoryFile" }]
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contentPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)(?!.*/$)[^\\u0000]+$"
    },
    "repositoryDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)(?!.*(?:^|/)\\.git(?:/|$))[^\\u0000]+$"
    },
    "sha1": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9A-Fa-f]{128}$" },
    "remoteHashes": {
      "type": "object",
      "required": ["sha1", "sha512"],
      "properties": {
        "sha1": { "$ref": "#/$defs/sha1" },
        "sha512": { "$ref": "#/$defs/sha512" }
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "repositoryHashes": {
      "type": "object",
      "required": ["sha1", "sha256"],
      "properties": {
        "sha1": { "$ref": "#/$defs/sha1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "environmentPolicy": {
      "type": "string",
      "enum": ["required", "optional", "unsupported"]
    },
    "environment": {
      "type": "object",
      "required": ["client", "server"],
      "properties": {
        "client": { "$ref": "#/$defs/environmentPolicy" },
        "server": { "$ref": "#/$defs/environmentPolicy" }
      },
      "additionalProperties": false
    },
    "fileBase": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/contentPath" },
        "env": { "$ref": "#/$defs/environment" },
        "fileSize": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "remoteFile": {
      "allOf": [
        { "$ref": "#/$defs/fileBase" },
        {
          "type": "object",
          "required": ["path", "hashes", "downloads", "fileSize"],
          "properties": {
            "path": { "$ref": "#/$defs/contentPath" },
            "hashes": { "$ref": "#/$defs/remoteHashes" },
            "env": { "$ref": "#/$defs/environment" },
            "downloads": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "format": "uri", "pattern": "^https://" }
            },
            "fileSize": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "additionalProperties": false
        }
      ]
    },
    "repositoryFile": {
      "allOf": [
        { "$ref": "#/$defs/fileBase" },
        {
          "type": "object",
          "required": ["path", "hashes", "downloads", "fileSize"],
          "properties": {
            "path": { "$ref": "#/$defs/contentPath" },
            "hashes": { "$ref": "#/$defs/repositoryHashes" },
            "env": { "$ref": "#/$defs/environment" },
            "downloads": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "format": "uri-reference",
                "pattern": "^\\./(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
              }
            },
            "fileSize": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "additionalProperties": false
        }
      ]
    },
    "parent": {
      "type": "object",
      "required": ["url", "hashes", "fileSize"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1, "pattern": "^(?!.*[\\\\/])[^\\u0000]+$" },
        "hashes": { "$ref": "#/$defs/repositoryHashes" },
        "fileSize": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/contentPath" },
        "recursive": { "type": "boolean", "default": false },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["client", "server"] },
          "default": ["client", "server"]
        }
      },
      "additionalProperties": false
    }
  }
}
